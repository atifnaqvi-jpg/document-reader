{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocuPro",
  "version": "1.2.1",
  "identifier": "com.docupro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocuPro",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "resources/fonts/*.ttf": "fonts/",
      "resources/fonts/LICENSE-Liberation.txt": "fonts/LICENSE-Liberation.txt",
      "resources/fonts/FONT-RECORD.md": "fonts/FONT-RECORD.md"
    }
  }
}
